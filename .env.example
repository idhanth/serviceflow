# ---- Core ----------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# ---- Database ------------------------------------------------------------
# Local (scripts/services.sh): port 5433, your macOS username as the role.
DATABASE_URL=postgresql+psycopg://USER@127.0.0.1:5433/serviceflow

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380/0

# ---- Auth ----------------------------------------------------------------
# "dev" issues local HS256 tokens so the seeded demo accounts work.
# Set AUTH_PROVIDER=clerk plus the Clerk values to switch providers.
AUTH_PROVIDER=dev
JWT_SECRET=change-me-to-at-least-32-characters-long
# CLERK_SECRET_KEY=
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# ---- Frontend ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
