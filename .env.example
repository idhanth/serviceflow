# ---- Core ----------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# ---- Database ------------------------------------------------------------
# Local (scripts/services.sh): port 5433, your macOS username as the role.
DATABASE_URL=postgresql+psycopg://USER@127.0.0.1:5433/serviceflow

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380/0

# ---- Auth ----------------------------------------------------------------
# "dev" issues local HS256 tokens so the seeded demo accounts work.
# Set AUTH_PROVIDER=clerk plus the Clerk values to switch providers.
AUTH_PROVIDER=dev
JWT_SECRET=change-me-to-at-least-32-characters-long
# CLERK_SECRET_KEY=
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# ---- Object storage ------------------------------------------------------
# Local development runs MinIO (scripts/services.sh). For production on AWS S3,
# unset S3_ENDPOINT_URL and supply real IAM credentials; nothing else changes.
S3_BUCKET=serviceflow-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=serviceflow
AWS_SECRET_ACCESS_KEY=serviceflow-dev-secret

# ---- Frontend ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ---- Email ---------------------------------------------------------------
# Local development captures mail in MailPit (scripts/services.sh) and never
# sends anything outward. Production sets EMAIL_PROVIDER=resend.
EMAIL_PROVIDER=smtp
EMAIL_FROM=ServiceFlow <hello@serviceflow.demo>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# RESEND_API_KEY=

# ---- Deployment topology -------------------------------------------------
# How many proxies sit in front of the API. The client IP is read that many
# hops from the right of X-Forwarded-For, so a wrong number here means rate
# limits are keyed on a proxy's address instead of the caller's. Locally the
# API is reached directly, so nothing is trusted.
TRUSTED_PROXY_COUNT=0

# Shared secret proving a request arrived through the Next.js server. Unset
# locally, which disables the check; production sets it on both sides.
# API_PROXY_TOKEN=

# The dev auth provider refuses to start in production unless this deployment
# is a deliberately public demo with published credentials.
# PUBLIC_DEMO_MODE=false
