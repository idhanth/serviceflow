[Unit]
Description=ServiceFlow Celery beat (scheduler)
After=network-online.target serviceflow-worker.service
Wants=network-online.target

[Service]
Type=exec
User=serviceflow
Group=serviceflow
WorkingDirectory=/opt/serviceflow/current/apps/api
EnvironmentFile=/etc/serviceflow/api.env

# Exactly one scheduler. Its state file lives outside the release directory so
# a deploy does not reset the schedule and re-fire everything.
ExecStart=/opt/serviceflow/current/apps/api/.venv/bin/celery \
  -A serviceflow.worker.celery_app beat --loglevel=info \
  --schedule=/var/lib/serviceflow/celerybeat-schedule

Restart=always
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/serviceflow /var/lib/serviceflow

[Install]
WantedBy=multi-user.target
