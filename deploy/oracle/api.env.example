# /etc/serviceflow/api.env  -  chmod 600, owned by root, never committed.
# Every value below is a placeholder. Real secrets are pasted on the server.

# ---- Environment ---------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# ---- Managed PostgreSQL (Neon) -------------------------------------------
# Use the POOLED connection string (…-pooler.…) and keep sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/serviceflow?sslmode=require

# Pool sizing is deliberate, not a default. Two uvicorn workers plus one Celery
# worker are three processes, each holding its own pool:
#     3 processes x (5 + 5) = 30 connections at absolute peak
# which stays inside Neon's free-tier ceiling with room for beat, migrations and
# a psql session. Raising these without raising the database's limit is how a
# deployment starts returning 503s under load.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Fail fast rather than holding a worker thread for half a minute (phase 8).
DATABASE_POOL_TIMEOUT=5

# ---- Managed Redis (Upstash) ---------------------------------------------
# rediss:// - TLS. Redis is required: it is the Celery broker, the realtime bus
# and the rate limiter. There is no in-memory fallback anywhere in this app.
REDIS_URL=rediss://default:PASSWORD@REGION.upstash.io:6379

# ---- Auth -----------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=replace-with-48-random-bytes-at-least-32-characters
AUTH_PROVIDER=dev
# This deployment is a public portfolio demo: the seeded admin/employee/customer
# logins are meant to work for anyone. Without this the API refuses to start
# with the local token provider in production, which is the correct default.
PUBLIC_DEMO_MODE=true

# ---- Frontend boundary ----------------------------------------------------
# The browser never calls this API directly; the Next.js server does. This
# secret is what proves a request came from it. openssl rand -hex 32
API_PROXY_TOKEN=replace-with-32-random-bytes
# Browser -> Vercel -> Caddy -> uvicorn. The frontend puts the browser's address
# first in X-Forwarded-For and Caddy appends its own peer, so the caller is two
# from the right.
TRUSTED_PROXY_COUNT=2
# Server-to-server only; the browser is same-origin with the frontend.
CORS_ORIGINS=https://serviceflow.example.com

# ---- Object storage (Cloudflare R2) ---------------------------------------
# Private bucket. Keys are minted server-side and reads are short-lived
# presigned GETs - never make this bucket public.
S3_BUCKET=serviceflow-media
S3_REGION=auto
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=r2-access-key-id
AWS_SECRET_ACCESS_KEY=r2-secret-access-key

# ---- Email (Resend) -------------------------------------------------------
# Genuine delivery. Delivery is at-least-once by design; see ADR 0006.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=ServiceFlow <bookings@your-verified-domain.com>

# ---- Limits ---------------------------------------------------------------
RATE_LIMITING_ENABLED=true
